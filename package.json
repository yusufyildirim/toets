{
  "name": "dpad-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "docs:dev": "pnpm --filter @dpad-tv/docs dev",
    "docs:build": "pnpm --filter @dpad-tv/docs build",
    "docs:check": "pnpm --filter @dpad-tv/docs check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.0"
  }
}
