{
  "name": "toets-monorepo",
  "private": true,
  "description": "toets monorepo: cross-platform E2E testing for TV apps (web, Android TV / Fire TV, tvOS) on Playwright Test.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "pack:local": "pnpm -r --filter './packages/**' exec pnpm pack --pack-destination",
    "test": "pnpm -r --filter './packages/**' --filter './examples/**' test",
    "typecheck": "pnpm -r --filter './packages/**' --filter './examples/**' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:api && pnpm test && pnpm docs:check",
    "docs:api": "typedoc",
    "docs:dev": "pnpm --filter @toets/docs dev",
    "docs:build": "pnpm --filter @toets/docs build",
    "docs:check": "pnpm --filter @toets/docs check",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
