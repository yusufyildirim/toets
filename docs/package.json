{
  "name": "@toets/docs",
  "version": "0.0.0",
  "private": true,
  "description": "toets documentation site, llms.txt and code example checks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "check": "pnpm typecheck && pnpm test && pnpm check:examples && pnpm check:skills && pnpm check:errors",
    "check:examples": "node scripts/check-examples.ts",
    "check:skills": "node scripts/check-skills.ts",
    "check:errors": "node scripts/error-codes.ts --check",
    "errors": "node scripts/error-codes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/examples/demo-app"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@toets/core": "workspace:^",
    "@toets/driver-android-tv": "workspace:^",
    "@toets/driver-tvos": "workspace:^",
    "@toets/driver-web": "workspace:^",
    "@toets/eslint-plugin": "workspace:^",
    "@toets/mcp": "workspace:^",
    "@toets/mock": "workspace:^",
    "@toets/protocol": "workspace:^",
    "@toets/sdk": "workspace:^",
    "@toets/sdk-react-native": "workspace:^",
    "@toets/test": "workspace:^",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "gray-matter": "^4.0.3",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "react": "~19.3.1",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  }
}
