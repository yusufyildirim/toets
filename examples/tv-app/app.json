{
  "expo": {
    "name": "dpad TV",
    "slug": "dpad-tv-example",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0e14",
    "ios": {
      "bundleIdentifier": "dev.dpad.example"
    },
    "android": {
      "package": "dev.dpad.example"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "dpad TV example"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "tvosDeploymentTarget": "17.0"
        }
      ],
      "expo-video"
    ]
  }
}
