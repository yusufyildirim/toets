{
  "name": "@dpad-tv/example-tv-app",
  "version": "0.0.0",
  "private": true,
  "description": "Example React Native TV app (Android TV, tvOS, web) used to dogfood dpad.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "api": "node server/main.ts api",
    "build:sdk": "pnpm --filter @dpad-tv/sdk-react-native... build",
    "build:web": "pnpm build:sdk && DPAD_E2E=${DPAD_E2E:-1} expo export --platform web --output-dir dist/web --clear",
    "serve:web": "node server/main.ts web",
    "build:android": "node scripts/build-native.ts android",
    "build:tvos": "node scripts/build-native.ts tvos",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "NODE_OPTIONS=--conditions=@dpad-tv/source playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dpad-tv/sdk-react-native": "workspace:^",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@dpad-tv/driver-android-tv": "workspace:^",
    "@dpad-tv/driver-tvos": "workspace:^",
    "@dpad-tv/driver-web": "workspace:^",
    "@dpad-tv/test": "workspace:^",
    "@playwright/test": "^1.65.1",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
