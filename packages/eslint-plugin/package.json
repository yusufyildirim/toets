{
  "name": "@toets/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules for toets TV app E2E tests: no fixed waits, semantic keys, stable page objects, no platform escape hatches.",
  "keywords": [
    "toets",
    "tv",
    "smart-tv",
    "tv-app",
    "e2e",
    "end-to-end",
    "testing",
    "test-automation",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "playwright"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/eslint-plugin#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@toets/core": "workspace:^"
  }
}
