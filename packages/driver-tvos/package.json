{
  "name": "@dpad-tv/driver-tvos",
  "version": "0.0.0",
  "description": "dpad driver for tvOS simulators, built on Appium XCUITest.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/core": "workspace:^",
    "@dpad-tv/protocol": "workspace:^",
    "appium": "4.0.0",
    "appium-xcuitest-driver": "13.6.1",
    "pngjs": "7.0.0",
    "webdriverio": "10.2.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5"
  }
}
