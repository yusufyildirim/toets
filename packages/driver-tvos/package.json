{
  "name": "@toets/driver-tvos",
  "version": "0.1.0",
  "description": "toets driver for tvOS simulators, built on Appium XCUITest.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "tvos",
    "apple-tv",
    "appium",
    "xcuitest",
    "simulator"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/driver-tvos"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/driver-tvos#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build:fixture": "fixtures/tvos-app/build.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/core": "workspace:^",
    "@toets/protocol": "workspace:^",
    "appium": "4.0.0",
    "appium-xcuitest-driver": "13.6.1",
    "pngjs": "7.0.0",
    "webdriverio": "10.2.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5"
  }
}
