{
  "name": "@dpad-tv/sdk-react-native",
  "version": "0.0.0",
  "description": "dpad in-app SDK adapter for React Native (incl. react-native-tvos and react-native-web).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/dpad.git",
    "directory": "packages/sdk-react-native"
  },
  "homepage": "https://github.com/yusufyildirim/dpad/tree/main/packages/sdk-react-native#readme",
  "bugs": "https://github.com/yusufyildirim/dpad/issues",
  "type": "module",
  "exports": {
    ".": {
      "@dpad-tv/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./noop": {
      "@dpad-tv/source": "./src/noop.ts",
      "typedoc": "./src/noop.ts",
      "types": "./dist/noop.d.ts",
      "default": "./dist/noop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/protocol": "workspace:^",
    "@dpad-tv/sdk": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.34.1",
    "react": "~19.3.1",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-reconciler": "0.34.0"
  },
  "sideEffects": false
}
