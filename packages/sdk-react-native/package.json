{
  "name": "@dpad-tv/sdk-react-native",
  "version": "0.0.0",
  "description": "dpad in-app SDK adapter for React Native (incl. react-native-tvos and react-native-web).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/protocol": "workspace:^",
    "@dpad-tv/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "~19.3.1",
    "react-native": "npm:react-native-tvos@0.88.1-0"
  }
}
