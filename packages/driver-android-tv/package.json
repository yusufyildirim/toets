{
  "name": "@dpad-tv/driver-android-tv",
  "version": "0.0.0",
  "description": "dpad driver for Android TV / Fire TV emulators, built on Appium UiAutomator2.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/dpad.git",
    "directory": "packages/driver-android-tv"
  },
  "homepage": "https://github.com/yusufyildirim/dpad/tree/main/packages/driver-android-tv#readme",
  "bugs": "https://github.com/yusufyildirim/dpad/issues",
  "type": "module",
  "exports": {
    ".": {
      "@dpad-tv/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "assets"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "test:device": "vitest run test/integration",
    "fixture:build": "cd fixtures/android-tv-app && ./gradlew assembleDebug",
    "helper:build": "helper/build.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/core": "workspace:^",
    "@dpad-tv/protocol": "workspace:^",
    "appium": "4.0.0",
    "appium-uiautomator2-driver": "9.3.0",
    "fast-xml-parser": "^5.12.1",
    "pngjs": "^7.0.0",
    "webdriverio": "10.2.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  }
}
