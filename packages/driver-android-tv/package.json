{
  "name": "@toets/driver-android-tv",
  "version": "0.1.0",
  "description": "toets driver for Android TV / Fire TV emulators, built on Appium UiAutomator2.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "android-tv",
    "fire-tv",
    "appium",
    "uiautomator2",
    "emulator"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/driver-android-tv"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/driver-android-tv#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "assets"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "test:device": "vitest run test/integration",
    "fixture:build": "cd fixtures/android-tv-app && ./gradlew assembleDebug",
    "helper:build": "helper/build.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/core": "workspace:^",
    "@toets/protocol": "workspace:^",
    "appium": "4.0.0",
    "appium-uiautomator2-driver": "9.3.0",
    "fast-xml-parser": "^5.12.1",
    "pngjs": "^7.0.0",
    "webdriverio": "10.2.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  }
}
