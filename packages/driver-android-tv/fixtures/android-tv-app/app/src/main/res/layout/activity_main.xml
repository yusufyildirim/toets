<?xml version="1.0" encoding="utf-8"?>
<!-- A deliberately plain View-based TV screen: no framework, no libraries. Resource IDs are the
     dpad test IDs. Three screens (home, details, player) live in one activity and are toggled
     by visibility; a status bar at the bottom echoes received keys and the launch payload. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1622"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/menu"
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Button
                    android:id="@+id/menu_home"
                    style="@style/MenuItem"
                    android:text="Home" />

                <Button
                    android:id="@+id/menu_settings"
                    style="@style/MenuItem"
                    android:text="Settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="Featured"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <HorizontalScrollView
                    android:id="@+id/rail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rail_items"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/disabled_button"
                    style="@style/Focusable"
                    android:layout_width="240dp"
                    android:layout_height="56dp"
                    android:contentDescription="Not available yet"
                    android:enabled="false"
                    android:text="Unavailable" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/details_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/play_button"
                    style="@style/Focusable"
                    android:layout_width="200dp"
                    android:layout_height="64dp"
                    android:text="Play" />

                <Button
                    android:id="@+id/favorite_button"
                    style="@style/Focusable"
                    android:layout_width="200dp"
                    android:layout_height="64dp"
                    android:text="Favorite" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/player_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/player_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/last_key"
            style="@style/Status" />

        <TextView
            android:id="@+id/key_hold"
            style="@style/Status" />

        <TextView
            android:id="@+id/launch_payload"
            style="@style/Status" />

        <TextView
            android:id="@+id/mock_result"
            style="@style/Status" />
    </LinearLayout>
</LinearLayout>
