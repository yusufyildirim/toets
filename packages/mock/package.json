{
  "name": "@toets/mock",
  "version": "0.1.0",
  "description": "toets network mocking: MSW handlers served by a host-side mock server with upstream proxying.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "mock",
    "msw",
    "network"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/mock"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/mock#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
