{
  "name": "@toets/test",
  "version": "0.1.0",
  "description": "Cross-platform E2E testing for TV apps on Playwright Test: one test for web, Android TV / Fire TV and tvOS, with focus and the remote as primitives.",
  "keywords": [
    "toets",
    "tv",
    "smart-tv",
    "tv-app",
    "e2e",
    "end-to-end",
    "testing",
    "test-automation",
    "playwright",
    "playwright-test",
    "test-runner",
    "android-tv",
    "google-tv",
    "fire-tv",
    "tvos",
    "apple-tv",
    "react-native-tvos",
    "focus",
    "focus-management",
    "spatial-navigation",
    "d-pad",
    "remote-control",
    "cross-platform"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/test#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "@toets/source": "./src/reporter.ts",
      "typedoc": "./src/reporter.ts",
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/core": "workspace:^",
    "@toets/mock": "workspace:^",
    "@toets/protocol": "workspace:^"
  },
  "devDependencies": {
    "@toets/driver-android-tv": "workspace:^",
    "@toets/driver-tvos": "workspace:^",
    "@toets/driver-web": "workspace:^",
    "@playwright/test": "^1.65.1"
  },
  "peerDependencies": {
    "@toets/driver-android-tv": "workspace:>=0.1.0 <1",
    "@toets/driver-tvos": "workspace:>=0.1.0 <1",
    "@toets/driver-web": "workspace:>=0.1.0 <1",
    "@playwright/test": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "@toets/driver-android-tv": {
      "optional": true
    },
    "@toets/driver-tvos": {
      "optional": true
    },
    "@toets/driver-web": {
      "optional": true
    }
  }
}
