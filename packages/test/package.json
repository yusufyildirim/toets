{
  "name": "@toets/test",
  "version": "0.0.0",
  "description": "toets test runner: Playwright Test fixtures, config and matchers for cross-platform TV E2E tests.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "playwright",
    "android-tv",
    "fire-tv",
    "tvos",
    "test-runner"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/test#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "@toets/source": "./src/reporter.ts",
      "typedoc": "./src/reporter.ts",
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/core": "workspace:^",
    "@toets/mock": "workspace:^",
    "@toets/protocol": "workspace:^"
  },
  "devDependencies": {
    "@toets/driver-android-tv": "workspace:^",
    "@toets/driver-tvos": "workspace:^",
    "@toets/driver-web": "workspace:^",
    "@playwright/test": "^1.65.1"
  },
  "peerDependencies": {
    "@toets/driver-android-tv": "workspace:^",
    "@toets/driver-tvos": "workspace:^",
    "@toets/driver-web": "workspace:^",
    "@playwright/test": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "@toets/driver-android-tv": {
      "optional": true
    },
    "@toets/driver-tvos": {
      "optional": true
    },
    "@toets/driver-web": {
      "optional": true
    }
  }
}
