{
  "name": "@dpad-tv/test",
  "version": "0.0.0",
  "description": "dpad test runner: Playwright Test fixtures, config and matchers for cross-platform TV E2E tests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/dpad.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/yusufyildirim/dpad/tree/main/packages/test#readme",
  "bugs": "https://github.com/yusufyildirim/dpad/issues",
  "type": "module",
  "exports": {
    ".": {
      "@dpad-tv/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "@dpad-tv/source": "./src/reporter.ts",
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/core": "workspace:^",
    "@dpad-tv/mock": "workspace:^",
    "@dpad-tv/protocol": "workspace:^"
  },
  "devDependencies": {
    "@dpad-tv/driver-android-tv": "workspace:^",
    "@dpad-tv/driver-tvos": "workspace:^",
    "@dpad-tv/driver-web": "workspace:^",
    "@playwright/test": "^1.65.1"
  },
  "peerDependencies": {
    "@dpad-tv/driver-android-tv": "workspace:^",
    "@dpad-tv/driver-tvos": "workspace:^",
    "@dpad-tv/driver-web": "workspace:^",
    "@playwright/test": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "@dpad-tv/driver-android-tv": {
      "optional": true
    },
    "@dpad-tv/driver-tvos": {
      "optional": true
    },
    "@dpad-tv/driver-web": {
      "optional": true
    }
  }
}
