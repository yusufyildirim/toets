{
  "name": "@toets/protocol",
  "version": "0.1.0",
  "description": "toets in-app SDK protocol for TV app E2E testing: JSON-RPC types, spec, host server and conformance suite.",
  "keywords": [
    "toets",
    "tv",
    "smart-tv",
    "tv-app",
    "e2e",
    "end-to-end",
    "testing",
    "test-automation",
    "protocol",
    "json-rpc",
    "websocket",
    "sdk",
    "conformance"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/protocol#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "@toets/source": "./src/server/index.ts",
      "typedoc": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./conformance": {
      "@toets/source": "./src/conformance/index.ts",
      "typedoc": "./src/conformance/index.ts",
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  },
  "bin": {
    "toets-conformance": "./dist/conformance/cli.js"
  }
}
