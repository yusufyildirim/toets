{
  "name": "@toets/driver-web",
  "version": "0.0.0",
  "description": "toets driver for web TV apps in Chromium, built on Playwright.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "smart-tv",
    "chromium",
    "playwright"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/driver-web"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/driver-web#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/core": "workspace:^",
    "@toets/protocol": "workspace:^",
    "playwright-core": "^1.65.1"
  }
}
