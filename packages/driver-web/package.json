{
  "name": "@dpad-tv/driver-web",
  "version": "0.0.0",
  "description": "dpad driver for web TV apps in Chromium, built on Playwright.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@dpad-tv/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/core": "workspace:^",
    "@dpad-tv/protocol": "workspace:^",
    "playwright-core": "^1.65.1"
  }
}
