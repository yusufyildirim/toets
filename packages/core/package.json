{
  "name": "@toets/core",
  "version": "0.0.0",
  "description": "Platform-neutral core of toets: driver contract, locators, matchers, focus, keys, capabilities.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "android-tv",
    "fire-tv",
    "tvos",
    "focus",
    "remote"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/core#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./runner": {
      "@toets/source": "./src/runner/index.ts",
      "typedoc": "./src/runner/index.ts",
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./testing": {
      "@toets/source": "./src/testing/index.ts",
      "typedoc": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/protocol": "workspace:^",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "yaml": "^2.9.1"
  }
}
