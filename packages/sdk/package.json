{
  "name": "@toets/sdk",
  "version": "0.1.0",
  "description": "toets in-app SDK core (framework neutral) and web adapter.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "sdk",
    "instrumentation",
    "web"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@toets/source": "./src/web/index.ts",
      "typedoc": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./noop": {
      "@toets/source": "./src/noop.ts",
      "typedoc": "./src/noop.ts",
      "types": "./dist/noop.d.ts",
      "default": "./dist/noop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/protocol": "workspace:^"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^31.0.1",
    "playwright-core": "1.65.1",
    "rolldown": "1.3.3"
  },
  "sideEffects": false
}
