{
  "name": "@dpad-tv/sdk",
  "version": "0.0.0",
  "description": "dpad in-app SDK core (framework neutral) and web adapter.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@dpad-tv/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "@dpad-tv/source": "./src/web/index.ts",
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./noop": {
      "@dpad-tv/source": "./src/noop.ts",
      "types": "./dist/noop.d.ts",
      "default": "./dist/noop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dpad-tv/protocol": "workspace:^"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^31.0.1",
    "playwright-core": "1.65.1",
    "rolldown": "1.3.3"
  },
  "sideEffects": false
}
