{
  "name": "@toets/mcp",
  "version": "0.1.0",
  "description": "toets MCP server: drive TV apps and read toets docs from agents with the same primitives tests use.",
  "keywords": [
    "toets",
    "tv",
    "e2e",
    "testing",
    "mcp",
    "model-context-protocol",
    "agents"
  ],
  "license": "MIT",
  "author": "Yusuf YILDIRIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufyildirim/toets.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/yusufyildirim/toets/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/yusufyildirim/toets/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "toets-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@toets/source": "./src/index.ts",
      "typedoc": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@toets/core": "workspace:^",
    "@toets/mock": "workspace:^",
    "@toets/protocol": "workspace:^",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@toets/driver-web": "workspace:^",
    "@toets/test": "workspace:^",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "playwright-core": "^1.65.1"
  }
}
